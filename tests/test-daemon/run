#!/bin/bash

# To be run within the VM

set -euo pipefail
IFS=$'\n\t'

# service is enabled as a system service
test "$(systemctl is-enabled hello.service)" = enabled

# service is of type simple
grep '^Type=simple$' /etc/systemd/system/hello.service

# service runs as the dedicated system user, with hardening
grep '^User=hello$' /etc/systemd/system/hello.service
grep '^NoNewPrivileges=true$' /etc/systemd/system/hello.service
grep '^PrivateTmp=true$' /etc/systemd/system/hello.service
grep '^ProtectSystem=full$' /etc/systemd/system/hello.service

# runtime_user is a nologin system account without a home directory
getent passwd hello | grep -q '/usr/sbin/nologin'
test "$(getent passwd hello | cut -d: -f6)" = /nonexistent